{
  "name": "poppler",
  "buildsystem": "simple",
  "build-commands": [
    "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/app -DBUILD_SHARED_LIBS=OFF -DBUILD_MANUAL_TESTS=OFF -DENABLE_BOOST=OFF -DENABLE_CPP=OFF -DENABLE_GLIB=OFF -DENABLE_QT5=OFF -DENABLE_QT6=OFF -DENABLE_LIBCURL=OFF -DENABLE_NSS3=OFF -DENABLE_GPGME=OFF",
    "cmake --build build --parallel 1 --target pdfinfo pdftoppm",
    "install -Dm755 -t /app/libexec/enzim-browser build/utils/pdfinfo build/utils/pdftoppm",
    "install -Dm644 -t /app/share/doc/enzim-browser/poppler COPYING poppler-26.11.0.tar.xz"
  ],
  "sources": [
    {
      "type": "archive",
      "url": "https://poppler.freedesktop.org/poppler-26.11.0.tar.xz",
      "sha256": "41c32680160addf5a8dd7a830e4869c01e9f6bee1abb91e44fabd1ba9d7828fb"
    },
    {
      "type": "file",
      "url": "https://poppler.freedesktop.org/poppler-26.11.0.tar.xz",
